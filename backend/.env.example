# Flask
SECRET_KEY=replace-with-strong-random-secret

# Gemini
# Comma-separated API keys
GEMINI_API_KEYS=your-gemini-key-1,your-gemini-key-2
GEMINI_MODEL=gemini-2.5-flash

# MQTT (HiveMQ Cloud)
MQTT_BROKER_HOST=your-broker-host.s1.eu.hivemq.cloud
MQTT_BROKER_PORT=8883
MQTT_USERNAME=your-mqtt-username
MQTT_PASSWORD=your-mqtt-password
MQTT_TOPIC=farm/sensor/data
MQTT_CLIENT_ID=crop-backend-subscriber
MQTT_CLIENT_ID_SIM=crop-sensor-simulator

# Blynk
BLYNK_TOKEN=your-blynk-token

# Flask
SECRET_KEY=replace-with-strong-random-secret

# MQTT: free public broker by default (no account needed).
# Pick a unique prefix; the ESP32 firmware and sensor_simulator.py use the same one.
MQTT_BROKER_HOST=broker.hivemq.com
MQTT_BROKER_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TOPIC_PREFIX=kisanmitra/your-team-name
MQTT_CLIENT_ID=kisanmitra-backend

# data.gov.in API key for Agmarknet mandi prices (free: https://data.gov.in)
DATA_GOV_IN_API_KEY=
